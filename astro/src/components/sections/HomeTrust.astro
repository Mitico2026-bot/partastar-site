---
// Home page manufacturer facts and certificates.
const { s } = Astro.props;
---
<section class="section tight">
  <div class="wrap trust">
    <div>
      <h2>{s.title}</h2>
      <p style="margin-top:14px;max-width:56ch" set:html={s.text} />
      <ul class="facts">{s.facts.map((f: string) => <li set:html={f} />)}</ul>
    </div>
    <div>
      <h3>{s.certsTitle}</h3>
      <ul class="certs">{s.certs.map((c: string) => <li>{c}</li>)}</ul>
      <p class="note" set:html={s.note} />
    </div>
  </div>
</section>
